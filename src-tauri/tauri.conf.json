{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prontuário de Casa",
  "version": "0.2.0",
  "identifier": "br.familia.arquivosaude",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Prontuário de Casa",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "backgroundColor": "#F4F7F7"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "category": "Medical",
    "shortDescription": "Saúde da família organizada num lugar só",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["PortugueseBR"],
        "installMode": "currentUser"
      },
      "wix": {
        "language": "pt-BR"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY1RTI0NjgyMDRCMjQxQTYKUldTbVFiSUVna2JpOVdTZXM2eFVHSlUyYTVRUUlxV2g2WGF3aHgrS2V5emI4V1RYVGlOL296OGoK",
      "endpoints": ["https://github.com/lucaslsm8/prontuario-de-casa/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
